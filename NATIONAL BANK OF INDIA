const jwt = require('jsonwebtoken');
const db = require('../db/database');

const router = express.Router();

const JWT_SECRET = process.env.JWT_SECRET || 'change-this-secret-before-going-live';
const ADMIN_USERNAME = process.env.ADMIN_USERNAME || 'admin';
const ADMIN_PASSWORD = process.env.ADMIN_PASSWORD || 'change-this-password';

router.post('/admin/login', (req, res) => {
  const { username, password } = req.body;

  if (username !== ADMIN_USERNAME || password !== ADMIN_PASSWORD) {
    return res.status(401).json({ error: 'Incorrect admin username or password.' });
  }

  const token = jwt.sign({ role: 'admin', username }, JWT_SECRET, { expiresIn: '4h' });
  res.cookie('admin_token', token, {
    httpOnly: true,
    sameSite: 'strict',
    secure: process.env.NODE_ENV === 'production',
    maxAge: 4 * 60 * 60 * 1000
  });
  return res.json({ message: 'Logged in.' });
});

router.post('/admin/logout', (req, res) => {
  res.clearCookie('admin_token');
  return res.json({ message: 'Logged out.' });
});

function requireAdmin(req, res, next) {
  const token = req.cookies?.admin_token;
  if (!token) return res.status(401).json({ error: 'Not logged in.' });
  try {
    const payload = jwt.verify(token, JWT_SECRET);
    if (payload.role !== 'admin') throw new Error('not admin');
    next();
  } catch (err) {
    return res.status(401).json({ error: 'Session expired. Please log in again.' });
  }
}

router.get('/admin/customers', requireAdmin, (req, res) => {
  const customers = db.prepare(
    'SELECT id, full_name, email, mobile, username, created_at FROM customers ORDER BY created_at DESC'
  ).all();
  return res.json({ customers });
});

router.get('/admin/logins', requireAdmin, (req, res) => {
  const logins = db.prepare(
    'SELECT id, username, success, attempted_at FROM login_logs ORDER BY attempted_at DESC LIMIT 200'
  ).all();
  return res.json({ logins });
});

module.exports = { router, requireAdmin };
